{
  "name": "x-wp/hook-invoker",
  "description": "Provides standardized way to declare and invoke WordPress hooks",
  "license": "GPL-2.0-only",
  "type": "library",
  "keywords": [
    "wordpress",
    "hooks",
    "actions",
    "filters",
    "hook-manager",
    "extended-wp"
  ],
  "authors": [
    {
      "name": "Sibin Grasic",
      "email": "sibin.grasic@oblak.studio"
    }
  ],
  "support": {
    "issues": "https://github.com/x-wp/hook-manager/issues"
  },
  "require": {
    "php": ">=8.0",
    "x-wp/di-implementation": "^1 || ^2"
  },
  "require-dev": {
    "x-wp/di": "^2.0",
    "oblak/wordpress-coding-standard": "^1.2",
    "php-stubs/wordpress-stubs": "^6.7",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^1.12",
    "phpstan/phpstan-deprecation-rules": "^1.2",
    "swissspidy/phpstan-no-private": "^0.2",
    "szepeviktor/phpstan-wordpress": "^1.3"
  },
  "suggest": {
    "automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
  },
  "autoload": {
    "psr-4": {
      "XWP\\Contracts\\Hook\\": "src/Compat/",
      "XWP\\Hook\\": "src/"
    },
    "files": [
      "src/Functions/xwp-hook-helper-fns.php",
      "src/Functions/xwp-shared-container-init.php"
    ]
  },
  "prefer-stable": true,
  "minimum-stability": "alpha",
  "config": {
    "allow-plugins": {
      "automattic/jetpack-autoloader": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  }
}
